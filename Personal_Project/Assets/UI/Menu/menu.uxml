    <engine:VisualElement name="MiddleArea" style="flex-grow: 1; background-image: none; background-color: rgba(0, 0, 0, 0); background-size: 100% 100%; opacity: 1; width: 50%; height: 100%; margin-left: 0; left: auto; right: auto; align-self: center; position: absolute;">
        <engine:VisualElement name="Maps" enabled="true" style="flex-grow: 0; height: 100%; width: 150%; flex-direction: column; flex-shrink: 0; position: relative; align-self: center;">
