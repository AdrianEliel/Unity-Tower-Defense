            <engine:Button text="&#10;" name="PlayButton" class="menu-button" style="background-image: url(&quot;project://database/Assets/UI/Menu/NewPlayButton.png?fileID=2800000&amp;guid=31189637c9d70734384a7b402074bc19&amp;type=3#NewPlayButton&quot;);" />
