<engine:UXML xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:engine="UnityEngine.UIElements" xmlns:editor="UnityEditor.UIElements" noNamespaceSchemaLocation="../../../UIElementsSchema/UIElements.xsd" editor-extension-mode="False">
    <Style src="project://database/Assets/UI/RoundUI/CharacterButtons.uss?fileID=7433441132597879392&amp;guid=0e4e63646d4bcf646be494317c21d190&amp;type=3#CharacterButtons" />
    <engine:VisualElement name="Screen" style="flex-grow: 1; width: auto;">
        <engine:VisualElement name="RoundStats" style="flex-grow: 1; width: 25%; height: 100%; flex-shrink: 0;">
            <engine:Label text="Label" />
        </engine:VisualElement>
        <engine:ScrollView style="width: 25%; height: 75%; align-self: flex-end; flex-grow: 0; flex-shrink: 0; flex-direction: column; position: absolute; align-items: flex-start; justify-content: flex-start; right: 0; bottom: 25%;">
            <engine:Button text="Soldier&#10;" name="Unit1" class="character-button" />
            <engine:Button text="Hunter&#10;" name="Unit1" class="character-button" />
            <engine:Button text="Sheriff" name="Unit1" class="character-button" />
        </engine:ScrollView>
    </engine:VisualElement>
</engine:UXML>
