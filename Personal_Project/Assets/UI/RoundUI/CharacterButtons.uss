.character-button {
    margin-top: 5px;
    margin-right: 5px;
    margin-bottom: 5px;
    margin-left: 5px;
    align-items: center;
    flex-direction: column;
    width: 75%;
    flex-wrap: wrap;
    align-content: flex-start;
    flex-grow: 1;
    align-self: center;
    flex-shrink: 1;
    font-size: 25px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    text-overflow: clip;
    height: 100%;
}
